<Window x:Class="HeatResponseToken.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HeatResponseToken"
        mc:Ignorable="d"
        Title="酷暑・熱中症対応記録（自己検証トークン）"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="0.6*"/>
        </Grid.ColumnDefinitions>

        <!-- 左側：入力フォーム -->
        <Border Grid.Column="0"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16"
            Background="#FAFAFA">
            <StackPanel>
                <TextBlock Text="入力フォーム"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,16"/>

                <!-- 位置情報（最重要） -->
                <TextBlock Text="位置情報"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
                <TextBox x:Name="LocationTextBox"
                     Height="28"
                     Margin="0,0,0,12"
                     Text="{Binding Location}"
                     ToolTip="場所名または住所を入力"/>

                <!-- 記録日時 -->
                <TextBlock Text="記録日時"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
                <DatePicker x:Name="RecordedAtPicker"
                 SelectedDate="{Binding RecordedAt}"
                        Height="28"
                        Margin="0,0,0,12"/>

                <!-- 気温 -->
                <TextBlock Text="気温（℃）"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>
                <TextBox x:Name="TemperatureTextBox"
                     Text="{Binding Temperature}"
                     Height="28"
                     Margin="0,0,0,20"
                     ToolTip="例: 36.5"/>

                <!-- 検証ボタン -->
                <Button x:Name="ValidateAndRecordButton"
                    Content="検証して記録"
                    Height="36"
                    FontWeight="Bold"
                    Background="#1976D2"
                    Foreground="White"
                    BorderThickness="0"
                    Command="{Binding ValidateAndRecordCommand}"
                    Cursor="Hand"/>


                <Button x:Name="ErrorDataButton"
    Content="エラーデータ型を表示"
    Height="36"
    FontWeight="Bold"
    Background="#1976D2"
    Foreground="White"
    BorderThickness="0"
    Command="{Binding ErrorRecordCommand}"
    Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- 右側：結果・履歴 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 検証結果パネル -->
            <Border x:Name="ValidationResultPanel"
                Grid.Row="0"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16"
                Background="#F5F5F5"
                MinHeight="100">
                <StackPanel>
                    <TextBlock Text="検証結果"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>
                    <TextBlock x:Name="ValidationMessageText"
                         Text="{Binding ValidationMessage}"
                           TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 履歴DataGrid -->
            <Border Grid.Row="2"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                           Text="履歴（検証済みトークンのみ）"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="4,4,4,8"/>
                    <DataGrid x:Name="HistoryDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          CanUserAddRows="False"
                          ItemsSource="{Binding Records}"
                          SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="記録日時"
                                            Binding="{Binding Value.RecordedAt}"
                                            Width="*"/>
                            <DataGridTextColumn Header="位置情報"
                                            Binding="{Binding Value.Location}"
                                            Width="*"/>
                            <DataGridTextColumn Header="気温（℃）"
                                            Binding="{Binding Value.Temperature}"
                                            Width="80"/>
                            <DataGridTextColumn Header="検証状態"
                                            Binding="{Binding ValidationStatus}"
                                            Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
